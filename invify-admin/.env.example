# Invify Frontend Environment Variables Example

# ==========================================
# 1. Quasar Identity Platform (QIP) Planes
# ==========================================

# ── Plane 1: Service Credentials (for QIP Administration) ──
# Issued by Quasar Platform team per vertical/service.
# NEVER commit real service credentials.
QUASAR_SERVICE_ID=qps_...
QUASAR_SERVICE_SECRET=qps_sec_...

# ── Plane 2: Client Credentials (for Provisioning) ──
# Retail Client
INVIFY_RETAIL_CLIENT_ID=qpc_...
INVIFY_RETAIL_CLIENT_SECRET=qpc_sec_...

# School Client
INVIFY_SCHOOL_CLIENT_ID=qpc_...
INVIFY_SCHOOL_CLIENT_SECRET=qpc_sec_...

# Services Client
INVIFY_SERVICES_CLIENT_ID=qpc_...
INVIFY_SERVICES_CLIENT_SECRET=qpc_sec_...

# ── Plane 3: Tenant Credentials (for Transactions) ──
# Passed dynamically from the DB or frontend per merchant
# e.g. sk_test_... or sk_live_...

# ==========================================
# 2. General Config
# ==========================================
PORT=3000
NODE_ENV=development

# Quasar Base URL
QUASAR_BASE_URL=https://api-quasar.iips.app/api/v1

# Public Google OAuth Web Client ID (onboarding "Sign up with Google")
VITE_GOOGLE_CLIENT_ID=
