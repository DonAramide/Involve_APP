# Invify Admin — staging build example (placeholders only)
# Copy to .env.staging (gitignored) for `vite build --mode staging`
# NEVER commit real values.

VITE_BUILD_VARIANT=STAGING
VITE_APP_ENV=staging
# Same-origin: browser uses /api /admin /public; Nginx proxies to backend.
# Do not set LAN, localhost, 127.0.0.1, :3000, or :3004.
VITE_API_URL=
VITE_SUPABASE_URL=<STAGING_SUPABASE_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Public Google OAuth Web Client ID for onboarding prefill (optional)
VITE_GOOGLE_CLIENT_ID=
