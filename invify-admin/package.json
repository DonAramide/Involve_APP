{
  "name": "invify-admin",
  "version": "0.0.1",
  "description": "IIPS Admin Panel with Engine Unit Tests",
  "private": true,
  "scripts": {
    "test": "jest --forceExit --runInBand --verbose",
    "test:coverage": "jest --forceExit --runInBand --coverage --verbose",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": ["**/tests/**/*.test.ts"],
    "moduleFileExtensions": ["ts", "js", "json"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "collectCoverageFrom": [
      "src/services/*.ts"
    ],
    "coverageReporters": ["text", "text-summary", "json-summary"],
    "coverageDirectory": "coverage"
  }
}
