# Staging environment file EXAMPLE — placeholders only. Never real values.
# Copy to .env.staging (gitignored) and fill from the staging secret plane.
# NEVER put production secrets here.
# NEVER commit .env.staging.
#
# Intended start:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
#
# Compose interpolates STAGING_* secret names into the container.
# Do not rely on a mixed developer .env for staging JWT/HMAC/Supabase values.
# Do not diagnose with `docker inspect` (it dumps env values). Use sanitized SET/UNSET checks.

NODE_ENV=staging
APP_ENV=staging
BUILD_VARIANT=STAGING
PORT=3000
FEATURE_REAL_MONEY_PAYOUTS=false
ENABLE_SIMULATOR=false
OFFLINE_LOCAL_AUTH=false
OFFLINE_MOCK_AUTH=false
ENABLE_INPROCESS_FINANCIAL_WORKERS=false

STAGING_IMAGE=invify:<git-sha>
STAGING_API_PORT=3000
STAGING_APP_URL=http://staging.invify.local:4173
CORS_ORIGINS=https://staging.invify.org
STAGING_QUASAR_BASE_URL=

# Dedicated STAGING Supabase (not DEV, not PROD) — new API key classes only
STAGING_SUPABASE_URL=<STAGING_SUPABASE_URL>
STAGING_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
STAGING_SUPABASE_SECRET_KEY=<sb_secret_...>

# Auth / crypto (staging-distinct; required; no hardcoded defaults)
STAGING_JWT_SECRET=<STAGING_SECRET>
STAGING_SUPABASE_JWT_SECRET=<STAGING_SECRET>
STAGING_LICENSE_HMAC_SECRET=<STAGING_SECRET>
STAGING_QUASAR_WEBHOOK_SIGNING_SECRET=<STAGING_SECRET>
