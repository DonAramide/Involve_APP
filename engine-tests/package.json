{
  "name": "invify-engine-tests",
  "version": "1.0.0",
  "description": "Standalone test runner for Invify Admin Engine Services",
  "private": true,
  "scripts": {
    "test": "jest --forceExit --runInBand --verbose",
    "test:coverage": "jest --forceExit --runInBand --coverage --verbose"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "^vue$": "<rootDir>/src/__mocks__/vue.ts"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
    },
    "collectCoverageFrom": ["../invify-admin/src/services/*.ts"],
    "coverageReporters": ["text", "text-summary"],
    "coverageDirectory": "coverage"
  }
}
