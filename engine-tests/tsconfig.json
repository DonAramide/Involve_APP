{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["./__mocks__/vue.ts"]
    }
  },
  "include": ["./**/*.ts", "../invify-admin/src/services/*.ts"],
  "exclude": ["node_modules"]
}
